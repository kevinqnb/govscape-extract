# Copy this file to `.env` and fill in credentials/config as needed.

# --- AWS credentials (data/build_sample.py's OCR download step only; ---
# --- download_pdfs.py needs no credentials at all) ---
# Any AWS account works; it will be billed for the (small) S3 transfer cost.
# If you already have credentials configured via `aws configure` / SSO /
# an existing profile, you can leave these untouched -- boto3 falls back
# to your default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2

# --- LLM extraction backend (govscape_extract/extractors/llm.py) ---
# Any OpenAI-compatible chat completions endpoint: hosted OpenAI, a local
# vLLM server, Ollama, etc. Leave GOVSCAPE_LLM_BASE_URL unset to use
# OpenAI's hosted API (requires a real GOVSCAPE_LLM_API_KEY in that case).
GOVSCAPE_LLM_MODEL=gpt-oss-120b
GOVSCAPE_LLM_BASE_URL=
GOVSCAPE_LLM_API_KEY=
