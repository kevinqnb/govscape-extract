# Copy this file to `.env` and fill in credentials/config as needed.

# --- AWS credentials (data/build_sample.py's OCR download step only; ---
# --- download_pdfs.py needs no credentials at all) ---
# Any AWS account works; it will be billed for the (small) S3 transfer cost.
# If you already have credentials configured via `aws configure` / SSO /
# an existing profile, you can leave these untouched -- boto3 falls back
# to your default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-west-2

# --- LLM extraction backend (govscape_extract/extractors/llm.py) ---
# Any OpenAI-compatible chat completions endpoint: hosted OpenAI, a local
# vLLM server, Ollama, etc. Leave GOVSCAPE_LLM_BASE_URL unset to use
# OpenAI's hosted API (requires a real GOVSCAPE_LLM_API_KEY in that case).
# experiments/runner.py load_dotenv()s this file, so the key below is what
# the hosted ground-truth model (gpt-5.6-terra) authenticates with.
GOVSCAPE_LLM_MODEL=gpt-5.6-terra
GOVSCAPE_LLM_BASE_URL=
GOVSCAPE_LLM_API_KEY=

# --- Per-model endpoints for the self-served experiment models ---
# One variable per `base_url_env` declared in experiments/config.py's
# MODEL_REGISTRY. These are the *fallback* path: if you start a server with
# `uv run -m experiments.serve_model --model-key <key>`, it registers the URL
# in experiments/.endpoints.json and the runner finds it without any of these
# being set. Fill one in only when the runner can't see that file (separate
# machine, no shared filesystem) or you started `vllm serve` by hand.
# vLLM ignores the API key, but the OpenAI SDK requires a non-empty string,
# so GOVSCAPE_LLM_API_KEY above must be set to *something* even for these.
GOVSCAPE_GPT_OSS_120B_BASE_URL=
GOVSCAPE_QWEN3_0_6B_BASE_URL=
GOVSCAPE_QWEN3_4B_BASE_URL=
GOVSCAPE_OLMO3_7B_INSTRUCT_BASE_URL=
GOVSCAPE_GEMMA4_12B_IT_BASE_URL=
GOVSCAPE_GEMMA4_31B_IT_BASE_URL=

# --- Frontier-model consensus panel (experiments/config.py "validation") ---
# Two hosted models reached through their provider's OpenAI-compatible
# endpoint. Both need a real API key (not "EMPTY"). The third panelist,
# gpt-5.6-terra, uses GOVSCAPE_LLM_API_KEY above.
GOVSCAPE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
GOVSCAPE_ANTHROPIC_API_KEY=
GOVSCAPE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOVSCAPE_GEMINI_API_KEY=
